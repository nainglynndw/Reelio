REELIO_TEXT_PROVIDER=google
GEMINI_API_KEY=
# Shared compatibility override. Task-specific models below take precedence.
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_CREATIVE_MODEL=gemini-3.6-flash
# Optional high-quality chat-story override: gemini-3.1-pro-preview (paid preview; no Gemini API free tier).
GEMINI_CONVERSATION_MODEL=gemini-3.6-flash
GEMINI_UTILITY_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=90000
REELIO_STT_PROVIDER=gemini
GEMINI_STT_MODEL=gemini-3.5-flash-lite
GEMINI_STT_TIMEOUT_MS=1800000
GEMINI_HIGHLIGHT_MODEL=gemini-3.5-flash-lite
GEMINI_HIGHLIGHT_TIMEOUT_MS=180000
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Persona voices are used unless this explicit brand override is enabled.
REELIO_BRAND_VOICE_OVERRIDE=false
GEMINI_TTS_VOICE=Puck
GEMINI_TTS_TIMEOUT_MS=120000
GEMINI_TTS_MAX_RETRIES=3
GEMINI_TTS_CONCURRENCY=2
GEMINI_TTS_BURMESE_SPEED=0.94
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=Reelio
OPENROUTER_TIMEOUT_MS=90000
KOKORO_PYTHON=.reelio/kokoro/venv/bin/python3
KOKORO_MODEL_PATH=.reelio/kokoro/models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=.reelio/kokoro/models/voices-v1.0.bin
KOKORO_VOICE=af_heart
KOKORO_VOICE_BLEND=af_heart:0.6,af_bella:0.4
KOKORO_SPEED=1.15
KOKORO_TIMEOUT_MS=900000
VOXCPM_PYTHON=.reelio/voxcpm2/venv/bin/python3
VOXCPM_MODEL_PATH=.reelio/voxcpm2/models/VoxCPM2
VOXCPM_DEVICE=auto
VOXCPM_CFG_VALUE=2
VOXCPM_INFERENCE_TIMESTEPS=10
VOXCPM_REFERENCE_INFERENCE_TIMESTEPS=40
VOXCPM_SEED=42
VOXCPM_TIMEOUT_MS=1800000
# Optional future/self-hosted fallback. Set REELIO_STT_PROVIDER=local to use it.
STT_PYTHON=.reelio/stt/venv/bin/python3
STT_MODEL=small
STT_MODEL_DIR=.reelio/stt/models
STT_DEVICE=auto
STT_COMPUTE_TYPE=default
STT_TIMEOUT_MS=1800000
WEB_MEDIA_DOWNLOADER=.reelio/web-media/venv/bin/yt-dlp
# Maximum one-file download from a public link (2 GiB).
REELIO_MAX_WEB_MEDIA_BYTES=2147483648
REELIO_MEDIA_TOOL_CONCURRENCY=2
REELIO_MODEL_TOOL_CONCURRENCY=1
# Shared local upload limit for modular Tools inputs and custom storyboard videos (10 GiB).
REELIO_MAX_TOOL_INPUT_BYTES=10737418240
VOXCPM_VOICE_DESCRIPTION=A clear, energetic, confident knowledge presenter with a warm natural voice and a medium conversational pace.
# Stock providers are independent; Reelio combines both or falls back to either one.
PEXELS_API_KEY=
PIXABAY_API_KEY=
REELIO_SERVICE_PORT=8788
NEXT_PUBLIC_REELIO_SERVICE_URL=http://localhost:8788
REELIO_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REELIO_DATA_DIR=.reelio
REELIO_ENABLE_CONVERSATION_VIDEO=true
# Optional explicit browser executable. Otherwise Reelio uses its data-directory browser or a supported system Chrome.
# REELIO_CHROMIUM_PATH=/absolute/path/to/chrome
REELIO_MAX_BODY_BYTES=65536
REELIO_PROCESS_TIMEOUT_MS=900000
REELIO_SHUTDOWN_TIMEOUT_MS=10000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8788/oauth/youtube/callback
YOUTUBE_PRIVACY=private
YOUTUBE_CATEGORY_ID=27
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
REELIO_HTTPS_PORT=8789
FACEBOOK_REDIRECT_URI=https://localhost:8789/oauth/facebook/callback
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_USER_ACCESS_TOKEN=
PUBLIC_MEDIA_BASE_URL=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_SCOPES=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8788/oauth/tiktok/callback
